{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {},
  "tabs": {
    "mode": "off"
  },
  "plugins": [
    "-cmux.tui",
    "./integrations/subagent-statusline",
    "./integrations/cmux-resume"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true
}
