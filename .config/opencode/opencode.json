{
  "$schema" : "https:\/\/opencode.ai\/config.json",
  "agent" : {
    "build" : {
      "model" : "openai\/gpt-5.6-sol",
      "variant" : "medium"
    },
    "explore" : {
      "mode" : "subagent",
      "model" : "openai\/gpt-5.6-terra",
      "variant" : "medium"
    },
    "general" : {
      "mode" : "subagent",
      "model" : "openai\/gpt-5.6-sol",
      "variant" : "medium"
    },
    "plan" : {
      "model" : "openai\/gpt-5.6-sol",
      "variant" : "high"
    }
  },
  "instructions" : [
    "{file:/Users/arthur/.config/opencode/AGENTS.md}"
  ],
  "mcp" : {
    "context7" : {
      "enabled" : true,
      "type" : "remote",
      "url" : "https:\/\/mcp.context7.com\/mcp"
    },
    "engram" : {
      "command" : [
        "\/opt\/homebrew\/opt\/engram\/bin\/engram",
        "mcp",
        "--tools=agent"
      ],
      "type" : "local"
    },
    "flyctl" : {
      "command" : [
        "\/opt\/homebrew\/bin\/fly",
        "mcp",
        "server"
      ],
      "enabled" : true,
      "type" : "local"
    }
  },
  "model" : "openai\/gpt-5.6-sol",
  "permission" : {
    "external_directory" : {
      "\/tmp\/**" : "allow",
      "~\/Developer\/**" : "allow"
    }
  },
  "plugin" : [
    "\/Users\/arthur\/.config\/opencode\/plugins\/notify.ts",
    "\/Users\/arthur\/.config\/opencode\/plugins\/private-aliases.ts",
    ".\/plugins\/cmux-session.js"
  ]
}
