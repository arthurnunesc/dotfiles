{
  "$schema" : "https://opencode.ai/config.json",
  "agents" : {
    "build" : {
      "description" : "Normal primary engineer and orchestrator. Owns dynamic routing, architecture, integration, and final validation.",
      "model" : "claude-agent/opus#medium"
    },
    "cheap-worker" : {
      "model" : "claude-agent/haiku#high"
    },
    "explore" : {
      "description" : "Read-only, low-overhead codebase investigation. Finds files, symbols, call paths, behavior, and tests; returns concise evidence without architecture speculation.",
      "hidden" : false,
      "mode" : "subagent",
      "model" : "claude-agent/haiku#medium",
      "permissions" : [
        {
          "action" : "*",
          "effect" : "deny",
          "resource" : "*"
        },
        {
          "action" : "read",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "read",
          "effect" : "ask",
          "resource" : "*.env"
        },
        {
          "action" : "read",
          "effect" : "ask",
          "resource" : "*.env.*"
        },
        {
          "action" : "read",
          "effect" : "allow",
          "resource" : "*.env.example"
        },
        {
          "action" : "glob",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "grep",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "webfetch",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "websearch",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "external_directory",
          "effect" : "ask",
          "resource" : "*"
        }
      ]
    },
    "general" : {
      "description" : "Bounded implementation compatibility agent for existing workflows. Prefer standard-worker for new delegation.",
      "hidden" : true,
      "mode" : "subagent",
      "model" : "claude-agent/sonnet#high"
    },
    "plan" : {
      "description" : "Optional analysis primary, selected explicitly by the user. Investigates and plans without implementation.",
      "model" : "claude-agent/opus#high",
      "permissions" : [
        {
          "action" : "*",
          "effect" : "deny",
          "resource" : "*"
        },
        {
          "action" : "read",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "read",
          "effect" : "ask",
          "resource" : "*.env"
        },
        {
          "action" : "read",
          "effect" : "ask",
          "resource" : "*.env.*"
        },
        {
          "action" : "read",
          "effect" : "allow",
          "resource" : "*.env.example"
        },
        {
          "action" : "glob",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "grep",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "webfetch",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "websearch",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "skill",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "question",
          "effect" : "allow",
          "resource" : "*"
        },
        {
          "action" : "external_directory",
          "effect" : "ask",
          "resource" : "*"
        },
        {
          "action" : "external_directory",
          "effect" : "allow",
          "resource" : "~/.opencode/plan/*"
        },
        {
          "action" : "edit",
          "effect" : "allow",
          "resource" : "~/.opencode/plan/*"
        },
        {
          "action" : "subagent",
          "effect" : "allow",
          "resource" : "explore"
        }
      ]
    },
    "standard-worker" : {
      "model" : "claude-agent/sonnet#high"
    }
  },
  "commands" : {
    "build" : {
      "agent" : "build",
      "description" : "Explicitly select the normal Build agent and its configured model/variant.",
      "subagent" : false,
      "template" : "Handle this request using the normal Build workflow: $ARGUMENTS"
    },
    "plan" : {
      "agent" : "plan",
      "description" : "Explicitly select optional read-only Plan and its configured model/variant.",
      "subagent" : false,
      "template" : "Analyze this request without implementation: $ARGUMENTS"
    }
  },
  "default_agent" : "build",
  "experimental" : {
    "policies" : [
      {
        "action" : "provider.use",
        "effect" : "deny",
        "resource" : "*"
      },
      {
        "action" : "provider.use",
        "effect" : "allow",
        "resource" : "openai"
      },
      {
        "action" : "provider.use",
        "effect" : "allow",
        "resource" : "claude-agent"
      }
    ]
  },
  "mcp" : {
    "context7" : {
      "enabled" : true,
      "type" : "remote",
      "url" : "https://mcp.context7.com/mcp",
      "oauth" : false,
      "headers" : {
        "CONTEXT7_API_KEY" : "{env:CONTEXT7_API_KEY}"
      }
    },
    "engram" : {
      "command" : [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type" : "local"
    },
    "flyctl" : {
      "command" : [
        "/opt/homebrew/bin/fly",
        "mcp",
        "server"
      ],
      "enabled" : true,
      "type" : "local"
    },
    "servers": {
      "home-assistant": {
        "type": "remote",
        "url": "https://homeassistant.arthurnun.es/api/mcp"
      }
    }
  },
  "model" : "claude-agent/opus",
  "permission" : {
    "external_directory" : {
      "/tmp/**" : "allow",
      "~/Developer/**" : "allow"
    }
  },
  "plugin" : [
    "./plugins/cmux"
  ],
  "providers" : {
    "openai" : {
      "models" : {
        "gpt-6.1-sol" : {
          "settings" : {
            "reasoningEffort" : "medium"
          }
        }
      }
    }
  }
}
