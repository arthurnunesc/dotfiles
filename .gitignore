# Ignore everything by default
*

# Whitelist dotfiles we want to track
!.gitignore
!.ignore
!README.md
!.dotfiles.code-workspace

# Zsh
!.zshenv
!.config/
!.config/zsh/
!.config/zsh/.zshrc

# Local scripts
!.local/
!.local/bin/
!.local/bin/print-ai-cli-tools

# Starship
!.config/starship/
!.config/starship/starship.toml

# Git
!.config/git/
!.config/git/ignore

# Ghostty
!.config/ghostty/
!.config/ghostty/config.ghostty

# CMux
!.config/cmux/
!.config/cmux/cmux.json

# GGA
!.config/gga/
!.config/gga/**

# OpenCode
!.config/opencode/
!.config/opencode/**
.config/opencode/package-lock.json
.config/opencode/context-mode/content/
.config/opencode/context-mode/sessions/

# Pi
!.pi/
!.pi/agent/
!.pi/agent/settings.json
!.pi/agent/mcp.json
!.pi/agent/trust.json
!.pi/agent/extensions/
!.pi/agent/extensions/*.ts
!.pi/agent/extensions/package.json
!.pi/agent/extensions/package-lock.json
!.pi/agent/skills/
!.pi/agent/skills/**

# Shared agent skills
!.agents/
!.agents/.skill-lock.json
!.agents/skills-migration-report.md
!.agents/skills/
!.agents/skills/**
.agents/skills/.DS_Store
.agents/skills/brag

# Codex local files we do want to track
!.codex/
!.codex/skills/
!.codex/skills/**
.codex/skills/_shared
.codex/skills/.system
!.codex/config.toml
!.codex/AGENTS.md
!.codex/engram-instructions.md
!.codex/engram-compact-prompt.md

# Orca integrations are app-managed and stay local
.orca/
.codex/hooks.json
.config/opencode/plugins/orca-*
.pi/agent/extensions/orca-*.ts
.copilot/hooks/orca.json
.grok/hooks/orca-status.json

# Private credentials, runtime state, and local backups
.config/opencode/secrets/
.config/opencode/service.json
.config/opencode/backups/
.config/opencode/*.bak*

# Regenerate installer-owned integrations rather than versioning local copies
.config/opencode/plugins/cmux/
.agents/skills/noqa-testing
.codex/skills/noqa-testing

# Capability role definitions are source configuration
!.codex/agents/
!.codex/agents/*.toml
