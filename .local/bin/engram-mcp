#!/bin/sh
# Keep --help local; all other arguments belong to engram mcp.
if [ "$#" -eq 1 ] && [ "$1" = "--help" ]; then
  printf '%s\n' 'Usage: engram-mcp [engram mcp options]' '' \
    'Launch Engram MCP. Non-Git T3 scratch directories default to project arthur' \
    'unless ENGRAM_PROJECT or local .engram/config.json is set. Explicit project' \
    'parameters and native --project retain normal Engram precedence.' '' \
    'Examples:' '  engram-mcp --tools=agent' '  engram-mcp --project my-project'
  exit 0
fi

command -v node >/dev/null 2>&1 || { echo 'engram-mcp: node not found in PATH' >&2; exit 1; }
command -v engram >/dev/null 2>&1 || { echo 'engram-mcp: engram not found in PATH' >&2; exit 1; }
case $0 in
  */*) script=$0 ;;
  *) script=$(command -v "$0") ;;
esac
script_dir=$(CDPATH= cd "$(dirname "$script")" && pwd -P) || { echo 'engram-mcp: cannot locate launcher directory' >&2; exit 1; }
helper=$script_dir/../../.config/engram/t3-project.mjs
[ -f "$helper" ] || { echo "engram-mcp: helper not found: $helper" >&2; exit 1; }
project=$(node "$helper") || exit $?
if [ "$project" = arthur ]; then
  ENGRAM_PROJECT=$project
  export ENGRAM_PROJECT
elif [ -n "$project" ]; then
  echo 'engram-mcp: unexpected helper output' >&2
  exit 1
fi
exec engram mcp "$@"
