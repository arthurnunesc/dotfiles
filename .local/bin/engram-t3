#!/bin/sh
# Run Engram so that T3 scratch threads ("No project") save to project "general".
#
# T3 creates one folder per scratch thread under $T3CODE_HOME/scratch (default
# ~/.t3/scratch). Outside Git, Engram names the project after the folder unless
# the folder has .engram/config.json. This launcher writes that file, then runs
# the normal engram binary. Other directories are not changed.
set -u

usage() {
  printf '%s\n' 'Usage: engram-t3 [engram arguments...]' \
    '       engram-t3 --prepare-only [directory]' '' \
    'If the directory (default: current) is a T3 scratch thread folder outside Git' \
    'without .engram/config.json, write {"project_name":"general"} there.' \
    'Then run engram with the given arguments; --prepare-only exits instead.' '' \
    'Examples:' '  engram-t3 mcp --tools=agent' '  engram-t3 --prepare-only ~/.t3/scratch/2026-11-11-hi-abc123'
}

prepare() {
  dir=$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P) || return 0
  t3_home=${T3CODE_HOME:-${HOME:-}/.t3}
  scratch=$(CDPATH= cd -- "$t3_home/scratch" 2>/dev/null && pwd -P) || return 0
  [ "$(dirname -- "$dir")" = "$scratch" ] || return 0
  [ -e "$dir/.engram/config.json" ] && return 0
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 && return 0
  mkdir -p "$dir/.engram" || return 0
  tmp="$dir/.engram/config.json.$$"
  printf '{"project_name":"general"}\n' >"$tmp" && mv -f "$tmp" "$dir/.engram/config.json" || rm -f "$tmp"
  return 0
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --prepare-only) prepare "${2:-.}"; exit 0 ;;
esac
prepare .
exec engram "$@"
